{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olufowosere",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-12",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admins", "/admins/"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": {"bindings": [{"name": "PORTFOLIO_DATA", "class_name": "PortfolioData"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PortfolioData"]}]
}
